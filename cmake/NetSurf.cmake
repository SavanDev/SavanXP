# NetSurf's MIT libraries (docs/desktop/WEBVIEWER_ENGINE.md): libparserutils,
# libwapcaplet, libhubbub, libdom with its hubbub binding, and libcss, pinned
# in vendor/netsurf/NETSURF_RELEASES.txt and built unmodified, twice from the
# same sources:
#
#   netsurf_<name>       for SUN programs: the user target, PIC for PIE
#                        programs, against the SDK's C headers
#   netsurf_<name>_host  for the host tests
#
# Each library names the ones it needs, so a program links the last one it
# uses (netsurf_css, netsurf_dom) and gets the rest. The files upstream
# generates at build time are generated here once, into the build tree, and
# serve both flavours.

set(SAVANXP_NETSURF_ROOT "${CMAKE_SOURCE_DIR}/vendor/netsurf")
set(SAVANXP_NETSURF_GENERATED "${CMAKE_BINARY_DIR}/netsurf-generated")

find_program(SAVANXP_PERL NAMES perl REQUIRED)
find_program(SAVANXP_GPERF NAMES gperf REQUIRED)
find_program(SAVANXP_NM NAMES llvm-nm REQUIRED)

# As upstream's release build: C99, the BSD and default extensions of the C
# headers, no iconv (libparserutils' own codecs), and NDEBUG -- without it the
# tokeniser and tree builder print every state they enter. _ALIGNED is what
# NetSurf's shared build system (not vendored: its makefiles only) defines for
# libcss' aligned structures; left undefined, `struct css_rule {...} _ALIGNED;`
# declares a variable in every file instead.
set(SAVANXP_NETSURF_DEFINES _BSD_SOURCE _DEFAULT_SOURCE WITHOUT_ICONV_FILTER NDEBUG
    "_ALIGNED=__attribute__((aligned))")

# --- What upstream generates ------------------------------------------------

# libparserutils' charset aliases and libhubbub's entities: Perl scripts that
# read build/<table> and write src/<dir>/<file>.inc, both relative to the
# directory they run in. Each runs in a directory of its own that holds a copy
# of its table.
set(pu_gen "${SAVANXP_NETSURF_GENERATED}/libparserutils")
set(hb_gen "${SAVANXP_NETSURF_GENERATED}/libhubbub")
add_custom_command(
    OUTPUT "${pu_gen}/src/charset/aliases.inc"
    COMMAND "${CMAKE_COMMAND}" -E make_directory "${pu_gen}/build" "${pu_gen}/src/charset"
    COMMAND "${CMAKE_COMMAND}" -E copy "${SAVANXP_NETSURF_ROOT}/libparserutils/build/Aliases" "${pu_gen}/build/Aliases"
    COMMAND "${SAVANXP_PERL}" "${SAVANXP_NETSURF_ROOT}/libparserutils/build/make-aliases.pl"
    WORKING_DIRECTORY "${pu_gen}"
    DEPENDS "${SAVANXP_NETSURF_ROOT}/libparserutils/build/make-aliases.pl"
            "${SAVANXP_NETSURF_ROOT}/libparserutils/build/Aliases"
    COMMENT "NetSurf: libparserutils charset aliases"
    VERBATIM)
add_custom_command(
    OUTPUT "${hb_gen}/src/tokeniser/entities.inc"
    COMMAND "${CMAKE_COMMAND}" -E make_directory "${hb_gen}/build" "${hb_gen}/src/tokeniser"
    COMMAND "${CMAKE_COMMAND}" -E copy "${SAVANXP_NETSURF_ROOT}/libhubbub/build/Entities" "${hb_gen}/build/Entities"
    COMMAND "${SAVANXP_PERL}" "${SAVANXP_NETSURF_ROOT}/libhubbub/build/make-entities.pl"
    WORKING_DIRECTORY "${hb_gen}"
    DEPENDS "${SAVANXP_NETSURF_ROOT}/libhubbub/build/make-entities.pl"
            "${SAVANXP_NETSURF_ROOT}/libhubbub/build/Entities"
    COMMENT "NetSurf: libhubbub character entities"
    VERBATIM)

# libhubbub's element names: gperf, with the table made static as upstream's
# Makefile does with sed.
add_custom_command(
    OUTPUT "${hb_gen}/src/treebuilder/autogenerated-element-type.c"
    COMMAND "${CMAKE_COMMAND}" -E make_directory "${hb_gen}/src/treebuilder"
    COMMAND "${SAVANXP_GPERF}" "--output-file=${hb_gen}/element-type.gperf.c"
            "${SAVANXP_NETSURF_ROOT}/libhubbub/src/treebuilder/element-type.gperf"
    COMMAND "${CMAKE_COMMAND}" "-DINPUT=${hb_gen}/element-type.gperf.c"
            "-DOUTPUT=${hb_gen}/src/treebuilder/autogenerated-element-type.c"
            -P "${CMAKE_SOURCE_DIR}/cmake/NetSurfStatic.cmake"
    DEPENDS "${SAVANXP_NETSURF_ROOT}/libhubbub/src/treebuilder/element-type.gperf"
            "${CMAKE_SOURCE_DIR}/cmake/NetSurfStatic.cmake"
    COMMENT "NetSurf: libhubbub element types"
    VERBATIM)

# libcss' property parsers: a host program, css_property_parser_gen.c, turns
# each line of properties.gen into autogenerated_<property>.c. The list of
# properties is read here, as upstream's Makefile reads it with Perl: every
# line that does not start with '#' and has a name before a colon.
set(css_props "${SAVANXP_NETSURF_ROOT}/libcss/src/parse/properties")
set(css_gen "${SAVANXP_NETSURF_GENERATED}/libcss")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${css_props}/properties.gen")
add_executable(savanxp-netsurf-css-gen-parser "${css_props}/css_property_parser_gen.c")
target_compile_options(savanxp-netsurf-css-gen-parser PRIVATE -w)
file(STRINGS "${css_props}/properties.gen" css_gen_lines)
set(SAVANXP_NETSURF_CSS_GENERATED "")
foreach(line IN LISTS css_gen_lines)
    if(line MATCHES "^([^#][^:]+):")
        set(property "${CMAKE_MATCH_1}")
        set(output "${css_gen}/autogenerated_${property}.c")
        add_custom_command(
            OUTPUT "${output}"
            COMMAND "${CMAKE_COMMAND}" -E make_directory "${css_gen}"
            COMMAND "$<TARGET_FILE:savanxp-netsurf-css-gen-parser>" -o "${output}" "${line}"
            DEPENDS savanxp-netsurf-css-gen-parser "${css_props}/properties.gen"
            COMMENT "NetSurf: libcss parser for ${property}"
            VERBATIM)
        list(APPEND SAVANXP_NETSURF_CSS_GENERATED "${output}")
    endif()
endforeach()

# --- Sources, as upstream's Makefiles list them -------------------------------

set(ns "${SAVANXP_NETSURF_ROOT}")
set(netsurf_parserutils_sources
    ${ns}/libparserutils/src/charset/aliases.c
    ${ns}/libparserutils/src/charset/codec.c
    ${ns}/libparserutils/src/charset/codecs/codec_ascii.c
    ${ns}/libparserutils/src/charset/codecs/codec_8859.c
    ${ns}/libparserutils/src/charset/codecs/codec_ext8.c
    ${ns}/libparserutils/src/charset/codecs/codec_utf8.c
    ${ns}/libparserutils/src/charset/codecs/codec_utf16.c
    ${ns}/libparserutils/src/charset/encodings/utf8.c
    ${ns}/libparserutils/src/charset/encodings/utf16.c
    ${ns}/libparserutils/src/input/filter.c
    ${ns}/libparserutils/src/input/inputstream.c
    ${ns}/libparserutils/src/utils/buffer.c
    ${ns}/libparserutils/src/utils/errors.c
    ${ns}/libparserutils/src/utils/stack.c
    ${ns}/libparserutils/src/utils/vector.c
    "${pu_gen}/src/charset/aliases.inc")
set(netsurf_parserutils_includes
    ${ns}/libparserutils/include ${ns}/libparserutils/src "${pu_gen}/src/charset")

set(netsurf_wapcaplet_sources ${ns}/libwapcaplet/src/libwapcaplet.c)
set(netsurf_wapcaplet_includes ${ns}/libwapcaplet/include)

file(GLOB netsurf_hubbub_treebuilder CONFIGURE_DEPENDS ${ns}/libhubbub/src/treebuilder/*.c)
set(netsurf_hubbub_sources
    ${ns}/libhubbub/src/parser.c
    ${ns}/libhubbub/src/charset/detect.c
    ${ns}/libhubbub/src/tokeniser/entities.c
    ${ns}/libhubbub/src/tokeniser/tokeniser.c
    ${netsurf_hubbub_treebuilder}
    ${ns}/libhubbub/src/utils/errors.c
    ${ns}/libhubbub/src/utils/string.c
    "${hb_gen}/src/tokeniser/entities.inc"
    "${hb_gen}/src/treebuilder/autogenerated-element-type.c")
# The generated element table is #included by element-type.c, not compiled.
set_source_files_properties("${hb_gen}/src/treebuilder/autogenerated-element-type.c"
    PROPERTIES HEADER_FILE_ONLY ON)
set(netsurf_hubbub_includes
    ${ns}/libhubbub/include ${ns}/libhubbub/src "${hb_gen}/src" "${hb_gen}/src/tokeniser")

file(GLOB netsurf_dom_core CONFIGURE_DEPENDS ${ns}/libdom/src/core/*.c)
file(GLOB netsurf_dom_events CONFIGURE_DEPENDS ${ns}/libdom/src/events/*.c)
file(GLOB netsurf_dom_html CONFIGURE_DEPENDS ${ns}/libdom/src/html/*.c)
file(GLOB netsurf_dom_utils CONFIGURE_DEPENDS ${ns}/libdom/src/utils/*.c)
set(netsurf_dom_sources
    ${netsurf_dom_core} ${netsurf_dom_events} ${netsurf_dom_html} ${netsurf_dom_utils}
    ${ns}/libdom/bindings/hubbub/parser.c)
# <dom/bindings/hubbub/parser.h> is where upstream installs the binding.
set(dom_gen "${SAVANXP_NETSURF_GENERATED}/libdom/include")
file(MAKE_DIRECTORY "${dom_gen}/dom/bindings")
file(COPY "${ns}/libdom/bindings/hubbub/parser.h" "${ns}/libdom/bindings/hubbub/errors.h"
    DESTINATION "${dom_gen}/dom/bindings/hubbub")
set(netsurf_dom_includes ${ns}/libdom/include ${ns}/libdom/src "${dom_gen}")

file(GLOB_RECURSE netsurf_css_all CONFIGURE_DEPENDS ${ns}/libcss/src/*.c)
list(REMOVE_ITEM netsurf_css_all "${css_props}/css_property_parser_gen.c")
set(netsurf_css_sources ${netsurf_css_all} ${SAVANXP_NETSURF_CSS_GENERATED})
set(netsurf_css_includes ${ns}/libcss/include ${ns}/libcss/src)

# --- The libraries --------------------------------------------------------------

# netsurf_library(<name> <flavour> <needed...>): one static library from
# netsurf_<name>_sources, with its own and its dependencies' headers.
function(netsurf_library name flavour)
    set(target netsurf_${name})
    if(flavour STREQUAL "host")
        set(target netsurf_${name}_host)
    endif()
    add_library(${target} STATIC ${netsurf_${name}_sources})
    target_include_directories(${target} PUBLIC ${netsurf_${name}_includes})
    target_compile_definitions(${target} PRIVATE ${SAVANXP_NETSURF_DEFINES})
    set_target_properties(${target} PROPERTIES C_STANDARD 99 C_EXTENSIONS NO)
    foreach(needed IN LISTS ARGN)
        if(flavour STREQUAL "host")
            target_link_libraries(${target} PUBLIC netsurf_${needed}_host)
        else()
            target_link_libraries(${target} PUBLIC netsurf_${needed})
        endif()
    endforeach()
    if(flavour STREQUAL "host")
        target_compile_options(${target} PRIVATE -O2 -w)
    else()
        # -w: upstream's code, not ours to warn about. Its headers reach the
        # program through PUBLIC include directories and are warned on there.
        # Line tables only: backtraces through the libraries, without the
        # six megabytes of full debug information every program that links
        # them would carry onto the disk and the LiveCD.
        target_compile_options(${target} PRIVATE ${SAVANXP_USER_COMPILE_OPTIONS_PIC} -O2 -w
            -gline-tables-only)
        target_include_directories(${target} PRIVATE
            "${CMAKE_SOURCE_DIR}/subsystems/posix/sdk/v1/include")
        set_property(GLOBAL APPEND PROPERTY SAVANXP_NETSURF_SUN_ARCHIVES ${target})
    endif()
endfunction()

foreach(flavour IN ITEMS sun host)
    netsurf_library(parserutils ${flavour})
    netsurf_library(wapcaplet ${flavour})
    netsurf_library(hubbub ${flavour} parserutils)
    netsurf_library(dom ${flavour} hubbub wapcaplet parserutils)
    netsurf_library(css ${flavour} wapcaplet parserutils)
endforeach()

# What the SUN libraries may ask the program for: C functions the runtime
# defines without a system call, as for OpenSSL (ports/openssl/link.sh), plus
# time(), which SUN's runtime answers natively (docs/userland/NATIVE_HEAP.md).
# Anything else -- a file, stdio, a thread -- would be a POSIX call inside a
# SUN program, and fails the build here.
set(SAVANXP_NETSURF_ALLOWED_SYMBOLS
    abs bsearch calloc free malloc memcmp memcpy memmove memset realloc
    snprintf __stack_chk_fail __stack_chk_guard strdup strlen strncasecmp
    strncmp strncpy strtol strtoul time tolower _GLOBAL_OFFSET_TABLE_)
get_property(netsurf_archives GLOBAL PROPERTY SAVANXP_NETSURF_SUN_ARCHIVES)
set(netsurf_archive_files "")
foreach(archive IN LISTS netsurf_archives)
    list(APPEND netsurf_archive_files "$<TARGET_FILE:${archive}>")
endforeach()
string(REPLACE ";" "," netsurf_allowed "${SAVANXP_NETSURF_ALLOWED_SYMBOLS}")
set(SAVANXP_NETSURF_SYMBOLS_STAMP "${SAVANXP_NETSURF_GENERATED}/symbols.stamp")
add_custom_command(
    OUTPUT "${SAVANXP_NETSURF_SYMBOLS_STAMP}"
    COMMAND "${Python3_EXECUTABLE}" "${CMAKE_SOURCE_DIR}/tools/check_archive_symbols.py"
            --nm "${SAVANXP_NM}" --name NetSurf
            --allow "${netsurf_allowed}"
            --stamp "${SAVANXP_NETSURF_SYMBOLS_STAMP}"
            ${netsurf_archive_files}
    DEPENDS ${netsurf_archives} "${CMAKE_SOURCE_DIR}/tools/check_archive_symbols.py"
    COMMENT "NetSurf: what the SUN libraries ask the program for"
    VERBATIM)
# Programs that link the SUN libraries depend on this target
# (add_dependencies), so none links an unchecked library.
add_custom_target(netsurf_symbols ALL DEPENDS "${SAVANXP_NETSURF_SYMBOLS_STAMP}")
