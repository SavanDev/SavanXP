# Writes the build number header (script mode: cmake -P).
#
#   -DSOURCE_DIR=<repository root> -DOUTPUT=<path to build_number.h>
#
# The build number is the commit count of HEAD (`git rev-list --count HEAD`),
# so it grows with every commit and the same code always gets the same number.
# Without git (a source tarball) it is 0. The file is only rewritten when the
# number changes, so a build with no new commit recompiles nothing.

execute_process(
    COMMAND git -C "${SOURCE_DIR}" rev-list --count HEAD
    OUTPUT_VARIABLE build_number
    OUTPUT_STRIP_TRAILING_WHITESPACE
    ERROR_QUIET
    RESULT_VARIABLE git_result
)
if(NOT git_result EQUAL 0 OR NOT build_number MATCHES "^[0-9]+$")
    set(build_number 0)
endif()

# Master always carries the next version: the release commit is the last one
# with that number, and the commit after it bumps include/shared/version.h.
# Warn when the version is already tagged on an earlier commit.
file(STRINGS "${SOURCE_DIR}/include/shared/version.h" version_lines
    REGEX "^#define SAVANXP_VERSION_(MAJOR|MINOR|PATCH) [0-9]+$")
set(version "")
foreach(line IN LISTS version_lines)
    string(REGEX REPLACE "^#define SAVANXP_VERSION_[A-Z]+ ([0-9]+)$" "\\1" part "${line}")
    list(APPEND version "${part}")
endforeach()
list(JOIN version "." version)
execute_process(
    COMMAND git -C "${SOURCE_DIR}" rev-parse -q --verify "refs/tags/v${version}^{commit}"
    OUTPUT_VARIABLE tag_commit
    OUTPUT_STRIP_TRAILING_WHITESPACE
    ERROR_QUIET
)
execute_process(
    COMMAND git -C "${SOURCE_DIR}" rev-parse HEAD
    OUTPUT_VARIABLE head_commit
    OUTPUT_STRIP_TRAILING_WHITESPACE
    ERROR_QUIET
)
if(tag_commit AND head_commit AND NOT tag_commit STREQUAL head_commit)
    message(WARNING
        "include/shared/version.h says ${version}, but v${version} is already released. "
        "Bump it to the next version (see docs/build/BUILD_CMAKE.md, \"Version and build number\").")
endif()

set(content "/* Generated by cmake/GenBuildNumber.cmake. Do not edit. */
#pragma once

#include \"shared/version.h\"

#define SAVANXP_BUILD_NUMBER ${build_number}
#define SAVANXP_BUILD_STRING \"${build_number}\"

/* \"v0.4.2 (Build 588)\": the release version followed by the build number. */
#define SAVANXP_FULL_VERSION_STRING SAVANXP_VERSION_STRING \" (Build \" SAVANXP_BUILD_STRING \")\"
/* \"0.4.2 (Build 588)\": the same without the leading v, for \"Version ...\" labels. */
#define SAVANXP_FULL_VERSION_NUMBER \\
    SAVANXP_STRINGIFY(SAVANXP_VERSION_MAJOR) \".\" SAVANXP_STRINGIFY(SAVANXP_VERSION_MINOR) \".\" \\
    SAVANXP_STRINGIFY(SAVANXP_VERSION_PATCH) \" (Build \" SAVANXP_BUILD_STRING \")\"
")

set(old "")
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" old)
endif()
if(NOT old STREQUAL content)
    file(WRITE "${OUTPUT}" "${content}")
endif()
