# Recursos SXE del reproductor. Ver docs/SXE_FORMAT.md.
#
# Se construye aparte (sdk/ffmpeg/build.ps1), asi que como Doom trae su icono
# adentro (icon_file=, un PNG relativo a este manifiesto) y se da de alta solo
# con category=.
#
# ext_open declara CAPACIDAD, no asociacion: los formatos que el set de
# configure.sh sabe abrir. Cual programa abre cada extension lo decide
# /disk/assoc.ini.
name=Media Player
description=Play audio and video files
version=0.1
version_string=Media Player 0.1 (FFmpeg 7.1.1)
vendor=SavanXP
accent=2f5f8f
icon_file=icon.png
mime_open=video/mp4,video/x-matroska,video/webm,audio/mpeg,audio/ogg,audio/flac,audio/wav
ext_open=.mp4,.m4v,.m4a,.mov,.mkv,.webm,.avi,.ogg,.ogv,.oga,.opus,.mp3,.flac,.wav,.mpg,.ts
category=Accessories
