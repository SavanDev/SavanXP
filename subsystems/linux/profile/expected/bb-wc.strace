execve("/bin/busybox.static", ["/bin/busybox.static", "wc", "/work/tree/a/f.txt"], ADDR /* 5 vars */) = 0
arch_prctl(ARCH_SET_FS, ADDR) = 0
set_tid_address(ADDR) = P1
getuid() = 0
open("/work/tree/a/f.txt", O_RDONLY|O_LARGEFILE) = 3
brk(NULL) = ADDR
brk(ADDR) = ADDR
mmap(ADDR, 4096, PROT_NONE, MAP_PRIVATE|MAP_FIXED|MAP_ANONYMOUS, -1, 0) = ADDR
mmap(NULL, 4096, PROT_READ|PROT_WRITE, MAP_PRIVATE|MAP_ANONYMOUS, -1, 0) = ADDR
read(3, "one\ntwo three\n", 1024) = 14
read(3, "", 1024) = 0
close(3) = 0
munmap(ADDR, 4096) = 0
ioctl(1, TIOCGWINSZ, ADDR) = -1 ENOTTY (Not a tty)
writev(1, [{iov_base="        2         3        14 /work/tree/a/f.txt", iov_len=48}, {iov_base="\n", iov_len=1}], 2) = 49
exit_group(0) = ?
