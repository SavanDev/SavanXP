execve("/bin/busybox.static", ["/bin/busybox.static", "pwd"], ADDR /* 5 vars */) = 0
arch_prctl(ARCH_SET_FS, ADDR) = 0
set_tid_address(ADDR) = P1
getuid() = 0
brk(NULL) = ADDR
brk(ADDR) = ADDR
mmap(ADDR, 4096, PROT_NONE, MAP_PRIVATE|MAP_FIXED|MAP_ANONYMOUS, -1, 0) = ADDR
mmap(NULL, 4096, PROT_READ|PROT_WRITE, MAP_PRIVATE|MAP_ANONYMOUS, -1, 0) = ADDR
getcwd("/work", 192) = 6
ioctl(1, TIOCGWINSZ, ADDR) = -1 ENOTTY (Not a tty)
writev(1, [{iov_base="/work", iov_len=5}, {iov_base="\n", iov_len=1}], 2) = 6
munmap(ADDR, 4096) = 0
exit_group(0) = ?
