# Recursos SXE del reproductor. Ver docs/userland/SXE_FORMAT.md y
# docs/media/MEDIA_PLAYER.md.
#
# icon_file resolves relative to THIS manifest, so the player's icon travels with
# it, in this directory: icon.png (16x16) and icon-32.png (32x32), the same art as
# app-mediaplayer in the catalog. It used to live in ports/ffmpeg/overlay/ with no
# copy in the tree: without an icon, the player showed up in the launcher with the
# generic desktop one, the only icon baked into the catalog.
icon_file=icon.png,icon-32.png

# Y lo de este manifiesto son las CAPACIDADES de medios: es lo que hace que Files
# abra un .avi o un .mp3 con /bin/mediaplayer. Si el port de FFmpeg no esta, el
# reproductor no llega a construirse y el registro lo descarta --como hace con Doom--
# asi que la asociacion no puede apuntar a un binario que no exista.
#
# Las extensiones son las que el port realmente habilita (ports/ffmpeg/configure.sh:
# --enable-demuxer y --enable-decoder). Anadir una aqui que el port no sepa
# decodificar daria un error de descompresion en vez de un aviso claro.
name=Media Player
description=Play video and audio files
version=system
vendor=SavanXP
accent=2f5f8f
mime_open=video/mp4,video/x-matroska,video/x-msvideo,video/mp2t,video/x-ivf,video/mpeg,video/x-m4v,audio/mpeg,audio/mp4,audio/wav,audio/x-wav,audio/flac,audio/ogg,audio/opus,audio/aac,audio/ac3
ext_open=.mp4,.m4v,.mov,.mkv,.webm,.avi,.ts,.m2ts,.mts,.mpg,.mpeg,.m2v,.ivf,.wav,.mp3,.mp2,.flac,.ogg,.oga,.ogv,.opus,.aac,.ac3
category=Accessories