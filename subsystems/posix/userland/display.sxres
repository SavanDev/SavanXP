# SXE resources of Display Properties. See docs/userland/SXE_FORMAT.md.
name=Display Properties
description=Wallpaper, its position and colour, and the screen's resolution
version=system
vendor=SavanXP
accent=3a68be
icon=app-display
category=System

# Fixed size, as a property sheet is: a larger window adds only empty face.
# The WM turns off Maximize and the resizing borders.
window_flags=fixed_size
