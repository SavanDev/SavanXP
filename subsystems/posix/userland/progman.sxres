# Recursos SXE del Program Manager. Ver docs/userland/SXE_FORMAT.md.
#
# These values are what windows and the launcher show for progman: its own
# runtime publishes them to windowd, and progman_registry.c's defaults
# reproduce them.
#
# Con category= a proposito: el launcher se lista a si mismo en System, en
# orden alfabetico entre Add/Remove Programs y System Properties. Sigue
# siendo opt-in -- busybox y los applets no declaran categoria y por eso no
# aparecen -- y el selftest verifica ambos lados.
name=Program Manager
description=Launcher de programas
version=system
vendor=SavanXP
accent=425c96
icon=desktop
category=System
