# System entry point for the optional FFmpeg Media Player port.
name=Media Player
description=Play audio and video files
version=system
vendor=SavanXP
accent=2f5f8f
icon=app-mediaplayer
category=Accessories
mime_open=video/mp4,video/x-matroska,video/webm,audio/mpeg,audio/ogg,audio/flac,audio/wav
ext_open=.mp4,.m4v,.m4a,.mov,.mkv,.webm,.avi,.ogg,.ogv,.oga,.opus,.mp3,.flac,.wav,.mpg,.ts
