// resource.exe's resources. The images come from images.py, written into the
// build directory, which is on llvm-rc's include path. The script is UTF-8
// (llvm-rc /C 65001).

#define VK_F2 0x71

STRINGTABLE
BEGIN
    1 "Solitario"
    2 "Atrás y adelante"
    15 "the last of the first block"
    17 "Juego número 17"
    100 "Puntos: %d"
END

10 BITMAP "core1.bmp"
11 BITMAP "info1.bmp"
12 BITMAP "core4.bmp"
13 BITMAP "info24.bmp"
CARDS BITMAP "core1.bmp"

20 ICON "icon.ico"
30 CURSOR "cursor.cur"

40 ACCELERATORS
BEGIN
    VK_F2, 1000, VIRTKEY
    "Z", 1001, VIRTKEY, CONTROL
    VK_F2, 1002, VIRTKEY, SHIFT
    "a", 1003
END
