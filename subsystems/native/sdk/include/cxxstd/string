/*
 * SavanXP - mini <string> freestanding del subsistema nativo.
 *
 * std::string respaldado por el heap del runtime (sxn_alloc), siempre
 * NUL-terminado, sin SSO. Es lo que el codegen de reflaxe.CPP usa para el
 * String de Haxe. Alcance: los metodos que el codegen y los helpers HxString
 * piden hoy; crecer bajo demanda (el error de compilacion es la senal).
 */
#pragma once

#include "__sxn_core"

namespace std {

inline size_t __sxn_strlen(const char* text) {
    size_t length = 0;
    while (text[length] != '\0') {
        length += 1;
    }
    return length;
}

class string {
    char* __data = nullptr;
    size_t __size = 0;
    size_t __capacity = 0; /* bytes utiles sin contar el NUL */

    static char* __empty_buffer() {
        static char empty[1] = {'\0'};
        return empty;
    }

    void __allocate_exact(size_t capacity) {
        __data = static_cast<char*>(sxn_alloc(capacity + 1));
        if (__data == nullptr) {
            sxn_log("cxx: std::string sin memoria");
            sxn_exit(133);
        }
        __capacity = capacity;
    }

    void __ensure(size_t required) {
        if (required <= __capacity) {
            return;
        }
        size_t next = __capacity == 0 ? 16 : __capacity * 2;
        if (next < required) {
            next = required;
        }
        char* previous = __data;
        size_t previous_size = __size;
        __allocate_exact(next);
        if (previous != nullptr) {
            memcpy(__data, previous, previous_size);
            sxn_free(previous);
        }
        __size = previous_size;
        __data[__size] = '\0';
    }

public:
    static const size_t npos = static_cast<size_t>(-1);

    string() {}

    string(const char* text) {
        if (text != nullptr && text[0] != '\0') {
            const size_t length = __sxn_strlen(text);
            __allocate_exact(length);
            memcpy(__data, text, length);
            __size = length;
            __data[__size] = '\0';
        }
    }

    string(const char* text, size_t count) {
        if (text != nullptr && count != 0) {
            __allocate_exact(count);
            memcpy(__data, text, count);
            __size = count;
            __data[__size] = '\0';
        }
    }

    string(size_t count, char fill) {
        if (count != 0) {
            __allocate_exact(count);
            for (size_t index = 0; index < count; ++index) {
                __data[index] = fill;
            }
            __size = count;
            __data[__size] = '\0';
        }
    }

    string(const string& other) {
        if (other.__size != 0) {
            __allocate_exact(other.__size);
            memcpy(__data, other.__data, other.__size);
            __size = other.__size;
            __data[__size] = '\0';
        }
    }

    string(string&& other) noexcept
        : __data(other.__data), __size(other.__size), __capacity(other.__capacity) {
        other.__data = nullptr;
        other.__size = 0;
        other.__capacity = 0;
    }

    ~string() {
        if (__data != nullptr) {
            sxn_free(__data);
        }
    }

    string& operator=(const string& other) {
        if (this != &other) {
            __size = 0;
            __ensure(other.__size);
            memcpy(__data != nullptr ? __data : __empty_buffer(), other.__data != nullptr ? other.__data : "", other.__size);
            __size = other.__size;
            if (__data != nullptr) {
                __data[__size] = '\0';
            }
        }
        return *this;
    }

    string& operator=(string&& other) noexcept {
        if (this != &other) {
            if (__data != nullptr) {
                sxn_free(__data);
            }
            __data = other.__data;
            __size = other.__size;
            __capacity = other.__capacity;
            other.__data = nullptr;
            other.__size = 0;
            other.__capacity = 0;
        }
        return *this;
    }

    string& operator=(const char* text) {
        __size = 0;
        return operator+=(text);
    }

    size_t size() const { return __size; }
    size_t length() const { return __size; }
    bool empty() const { return __size == 0; }
    size_t capacity() const { return __capacity; }
    void clear() { __size = 0; if (__data != nullptr) { __data[0] = '\0'; } }
    void reserve(size_t capacity) { __ensure(capacity); }

    const char* c_str() const { return __data != nullptr ? __data : __empty_buffer(); }
    const char* data() const { return c_str(); }
    char* data() { return __data != nullptr ? __data : __empty_buffer(); }

    char& operator[](size_t index) { return __data[index]; }
    const char& operator[](size_t index) const { return __data[index]; }

    char* begin() { return data(); }
    char* end() { return data() + __size; }
    const char* begin() const { return c_str(); }
    const char* end() const { return c_str() + __size; }

    char front() const { return __data[0]; }
    char back() const { return __data[__size - 1]; }

    void push_back(char value) {
        __ensure(__size + 1);
        __data[__size] = value;
        __size += 1;
        __data[__size] = '\0';
    }

    string& append(const char* text, size_t count) {
        if (count != 0) {
            __ensure(__size + count);
            memcpy(__data + __size, text, count);
            __size += count;
            __data[__size] = '\0';
        }
        return *this;
    }

    string& append(const char* text) {
        return text != nullptr ? append(text, __sxn_strlen(text)) : *this;
    }

    string& append(const string& other) { return append(other.c_str(), other.__size); }

    string& operator+=(const string& other) { return append(other); }
    string& operator+=(const char* text) { return append(text); }
    string& operator+=(char value) {
        push_back(value);
        return *this;
    }

    string substr(size_t position = 0, size_t count = npos) const {
        if (position >= __size) {
            return string();
        }
        const size_t available = __size - position;
        return string(c_str() + position, count < available ? count : available);
    }

    size_t find(char needle, size_t position = 0) const {
        for (size_t index = position; index < __size; ++index) {
            if (__data[index] == needle) {
                return index;
            }
        }
        return npos;
    }

    size_t find(const char* needle, size_t position = 0) const {
        const size_t needle_length = needle != nullptr ? __sxn_strlen(needle) : 0;
        if (needle_length == 0) {
            return position <= __size ? position : npos;
        }
        if (needle_length > __size) {
            return npos;
        }
        for (size_t index = position; index + needle_length <= __size; ++index) {
            if (memcmp(__data + index, needle, needle_length) == 0) {
                return index;
            }
        }
        return npos;
    }

    size_t find(const string& needle, size_t position = 0) const {
        return find(needle.c_str(), position);
    }

    size_t rfind(char needle, size_t position = npos) const {
        if (__size == 0) {
            return npos;
        }
        size_t index = position >= __size ? __size - 1 : position;
        for (;;) {
            if (__data[index] == needle) {
                return index;
            }
            if (index == 0) {
                return npos;
            }
            index -= 1;
        }
    }

    size_t rfind(const string& needle, size_t position = npos) const {
        const size_t needle_length = needle.__size;
        if (needle_length == 0) {
            return position < __size ? position : __size;
        }
        if (needle_length > __size) {
            return npos;
        }
        size_t start = __size - needle_length;
        if (position < start) {
            start = position;
        }
        for (;;) {
            if (memcmp(c_str() + start, needle.c_str(), needle_length) == 0) {
                return start;
            }
            if (start == 0) {
                return npos;
            }
            start -= 1;
        }
    }

    int compare(const string& other) const {
        const size_t shortest = __size < other.__size ? __size : other.__size;
        const int order = memcmp(c_str(), other.c_str(), shortest);
        if (order != 0) {
            return order;
        }
        if (__size == other.__size) {
            return 0;
        }
        return __size < other.__size ? -1 : 1;
    }
};

inline bool operator==(const string& left, const string& right) {
    return left.size() == right.size() && memcmp(left.c_str(), right.c_str(), left.size()) == 0;
}
inline bool operator==(const string& left, const char* right) {
    return right != nullptr && left == string(right);
}
inline bool operator==(const char* left, const string& right) { return right == left; }
inline bool operator!=(const string& left, const string& right) { return !(left == right); }
inline bool operator!=(const string& left, const char* right) { return !(left == right); }
inline bool operator!=(const char* left, const string& right) { return !(right == left); }
inline bool operator<(const string& left, const string& right) { return left.compare(right) < 0; }
inline bool operator>(const string& left, const string& right) { return right < left; }
inline bool operator<=(const string& left, const string& right) { return !(right < left); }
inline bool operator>=(const string& left, const string& right) { return !(left < right); }

inline string operator+(const string& left, const string& right) {
    string result(left);
    result += right;
    return result;
}
inline string operator+(const string& left, const char* right) {
    string result(left);
    result += right;
    return result;
}
inline string operator+(const char* left, const string& right) {
    string result(left);
    result += right;
    return result;
}
inline string operator+(const string& left, char right) {
    string result(left);
    result += right;
    return result;
}
inline string operator+(char left, const string& right) {
    string result(1, left);
    result += right;
    return result;
}

/* --- to_string ---------------------------------------------------------------- */

inline string __sxn_int_to_string(long long value) {
    char digits[24];
    size_t count = 0;
    const bool negative = value < 0;
    unsigned long long magnitude =
        negative ? 0ull - static_cast<unsigned long long>(value) : static_cast<unsigned long long>(value);
    do {
        digits[count++] = static_cast<char>('0' + (magnitude % 10));
        magnitude /= 10;
    } while (magnitude != 0);

    string result;
    result.reserve(count + 1);
    if (negative) {
        result += '-';
    }
    while (count != 0) {
        result += digits[--count];
    }
    return result;
}

inline string to_string(int value) { return __sxn_int_to_string(value); }
inline string to_string(long value) { return __sxn_int_to_string(value); }
inline string to_string(long long value) { return __sxn_int_to_string(value); }
inline string to_string(unsigned value) { return __sxn_int_to_string(static_cast<long long>(value)); }
inline string to_string(unsigned long value) { return __sxn_int_to_string(static_cast<long long>(value)); }

/* --- stoi --------------------------------------------------------------------
 * Parser entero puro (sin float, sin excepciones). El std::stoi real lanza ante
 * entrada invalida; este devuelve lo parseado hasta el primer no-digito (0 si
 * no hay ninguno). Suficiente para Std.parseInt del subsistema nativo (ver el
 * shadow haxe-std-fixes/Std.hx). No hay stof: Float sigue sin soporte. */
inline int stoi(const string& text) {
    const char* cursor = text.c_str();
    while (*cursor == ' ' || *cursor == '\t' || *cursor == '\n' || *cursor == '\r') {
        ++cursor;
    }
    bool negative = false;
    if (*cursor == '+' || *cursor == '-') {
        negative = (*cursor == '-');
        ++cursor;
    }
    long value = 0;
    while (*cursor >= '0' && *cursor <= '9') {
        value = value * 10 + (*cursor - '0');
        ++cursor;
    }
    return static_cast<int>(negative ? -value : value);
}

inline string to_string(double value) {
    /* Formato simple: parte entera + hasta 6 decimales sin ceros finales. */
    string result;
    if (value < 0) {
        result += '-';
        value = -value;
    }
    long long integer_part = static_cast<long long>(value);
    result += __sxn_int_to_string(integer_part);
    double fraction = value - static_cast<double>(integer_part);
    if (fraction > 0) {
        char decimals[8];
        int used = 0;
        for (int index = 0; index < 6; ++index) {
            fraction *= 10;
            const int digit = static_cast<int>(fraction);
            decimals[used++] = static_cast<char>('0' + digit);
            fraction -= digit;
        }
        while (used > 0 && decimals[used - 1] == '0') {
            used -= 1;
        }
        if (used > 0) {
            result += '.';
            result.append(decimals, static_cast<size_t>(used));
        }
    }
    return result;
}

inline string to_string(float value) { return to_string(static_cast<double>(value)); }

