SxBASIC Form 1

Begin Form MainForm
    Text = "Greeter"
    Width = 300
    Height = 112
    Begin Label PromptLabel
        Text = "Your name:"
        Left = 8
        Top = 12
        Width = 80
        Height = 20
    End
    Begin TextBox NameBox
        Left = 92
        Top = 8
        Width = 200
        Height = 24
    End
    Begin Button GreetButton
        Text = "Greet"
        Left = 208
        Top = 40
        Width = 84
        Height = 26
    End
    Begin Label ResultLabel
        Text = ""
        Left = 8
        Top = 80
        Width = 284
        Height = 20
    End
End

' The one-form sample of the Savan BASIC reference (docs/userland/SXBASIC.md).

Private Sub Form_Load()
    NameBox.SetFocus
End Sub

Private Sub GreetButton_Click()
    Dim name As String = Trim(NameBox.Text)
    If name = "" Then
        MsgBox "Type a name first.", mbWarning, "Greeter"
        NameBox.SetFocus
        Exit Sub
    End If
    ResultLabel.Text = "Hello, " & name & "!"
End Sub
