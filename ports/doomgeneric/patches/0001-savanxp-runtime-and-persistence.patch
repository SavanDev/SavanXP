     CONFIG_VARIABLE_GENERIC(name, DEFAULT_FLOAT)
 #define CONFIG_VARIABLE_STRING(name) \
     CONFIG_VARIABLE_GENERIC(name, DEFAULT_STRING)
+
+static uint32_t M_GetFloatBits(const float *value)
+{
+    uint32_t bits = 0;
+    memcpy(&bits, value, sizeof(bits));
+    return bits;
+}
+
+static void M_SetFloatBits(float *value, uint32_t bits)
+{
+    memcpy(value, &bits, sizeof(bits));
+}
+
+static const char *M_FloatBitsToText(uint32_t bits)
+{
+    switch (bits)
+    {
+        case 0x00000000u:
+            return "0";
+        case 0x3f000000u:
+            return "0.5";
+        case 0x3f800000u:
+            return "1";
+        case 0x40000000u:
+            return "2";
+        default:
+            return "1";
+    }
+}
+
+static uint32_t M_ParseFloatBits(const char *value)
+{
+    if (strcmp(value, "0") == 0 || strcmp(value, "0.0") == 0)
+    {
+        return 0x00000000u;
+    }
+    if (strcmp(value, "0.5") == 0)
+    {
+        return 0x3f000000u;
+    }
+    if (strcmp(value, "1") == 0 || strcmp(value, "1.0") == 0)
+    {
+        return 0x3f800000u;
+    }
+    if (strcmp(value, "2") == 0 || strcmp(value, "2.0") == 0)
+    {
+        return 0x40000000u;
+    }
+
+    return 0x3f800000u;
+}
 
