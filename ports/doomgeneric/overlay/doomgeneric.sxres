# Recursos SXE del port de DoomGeneric. Ver docs/userland/SXE_FORMAT.md.
#
# Los valores reproducen la presentacion que hasta ahora vivia hardcodeada en
# windowd_appinfo.c y en los defaults de progman_registry.c, que eran el unico
# lugar donde este programa tenia identidad: se construye con un build APARTE
# (ports/doomgeneric/build.sh), asi que era el ultimo que seguia cayendo al
# fallback del set horneado.
#
# The icon is declared with icon_file=, PNGs RELATIVE to this manifest:
# icon.png (16x16) and icon-32.png (32x32), next to this file, drawn in the
# house style (docs/desktop/ICON_STYLE.md). Doom does not depend on
# the general catalog -- the icon travels INSIDE the executable, which is what
# the format exists for. The other form, icon=<name>, resolves against
# assets/desktop/icons/, and that catalog has no entry for Doom.
#
# category= es lo que da de alta el port en la lista de programas del sistema:
# el binario se instala con un build aparte, nadie lo anota en ningun registro
# del host, y aun asi aparece en su grupo la proxima vez que se abre el menu.
#
# La version es la del motor (PACKAGE_STRING de config.h), NO la del sistema:
# esto no se envia con SavanXP, es un port de terceros que se instala aparte.
name=Doom
description=Classic FPS test port
version=0.1
version_string=Doom Generic 0.1
vendor=doomgeneric
accent=b55137
icon_file=icon.png,icon-32.png
launch_flags=fullscreen
category=Games

# Los WAD viven aca (FILES_DIR en doomgeneric_savanxp.c) y son ~30 MiB que
# ningun otro programa nombra. Declararlo es lo que le permite al desinstalador
# ofrecer llevarselos en vez de dejarlos huerfanos en el disco.
data_dir=/games/doom
