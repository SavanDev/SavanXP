 	void FileTimeToString( char *p, int size, long int time ) override
 	{
 		const time_t curtime = time;
+#if XASH_SAVANXP
+		struct tm local;
+		char buf[64];
+
+		if( !localtime_r( &curtime, &local ) ||
+			!strftime( buf, sizeof( buf ), "%a %b %e %T %Y\n", &local ))
+			buf[0] = '\0';
+#else
 		char *buf = ctime( &curtime );
+#endif

 		Q_strncpy( p, buf, size );
 	}
