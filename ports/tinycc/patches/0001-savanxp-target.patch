+    void *prw;
+    long handle = section_create(size,
+        SAVANXP_SECTION_READ | SAVANXP_SECTION_WRITE | SAVANXP_SECTION_EXEC);
+    if (handle < 0)
+	return tcc_error_noabort("tccrun: could not create the code section");
+    ptr = map_view((int)handle, SAVANXP_SECTION_READ | SAVANXP_SECTION_EXEC);
