 /* Output an elf, coff or binary file */
 /* XXX: suppress unneeded sections */
+#if TARGETOS_SavanXP
+/* An executable named <name>.sxe is a SUN program, the rule build-user.sh
+   and stamp_osabi.py enforce (docs/userland/SXE_FORMAT.md, "SUN programs are
+   named .sxe"). */
+static int sx_names_sun_program(int file_type, const char *filename)
+{
+    size_t length = strlen(filename), suffix = strlen(SXE_FILE_EXTENSION);
+
+    return file_type == TCC_OUTPUT_EXE
+        && length > suffix
+        && filename[length - suffix - 1] != '/'
+        && !strcmp(filename + length - suffix, SXE_FILE_EXTENSION);
+}
+
+static void sx_put_record(Section *s, unsigned tag, const void *payload,
+                          unsigned length)
+{
+    unsigned padded = (length + SXE_RECORD_ALIGNMENT - 1)
+        & ~(SXE_RECORD_ALIGNMENT - 1);
+    unsigned char *p = section_ptr_add(s, SXE_RECORD_HEADER_BYTES + padded);
+
+    memset(p, 0, SXE_RECORD_HEADER_BYTES + padded);
+    write16le(p, tag);
+    write16le(p + 2, SXE_RECORD_NONE);
+    write32le(p + 4, length);
+    memcpy(p + SXE_RECORD_HEADER_BYTES, payload, length);
+}
+
+/* A SUN program is an SXE image: .sxmeta, not allocated, with the identity
+   every program gets unasked (gen_sxe_resources.py, "default stamping"): its
+   NAME, the file name without .sxe, and SUBSYSTEM, the mirror of EI_OSABI.
+   VERSION and BUILD_ID are left out: tcc knows neither. */
+static void sx_create_sxmeta(TCCState *s1, const char *filename)
+{
+    Section *s = new_section(s1, SXE_SECTION_META, SHT_PROGBITS, 0);
+    const char *name = tcc_basename(filename);
+    unsigned name_length = strlen(name) - strlen(SXE_FILE_EXTENSION);
+    unsigned char subsystem = SXN_ELF_OSABI_NATIVE;
+    unsigned char *header;
+
+    s->sh_addralign = SXE_RECORD_ALIGNMENT;
+    header = section_ptr_add(s, SXE_META_HEADER_BYTES);
+    memset(header, 0, SXE_META_HEADER_BYTES);
+    header[0] = SXE_META_MAGIC0;
+    header[1] = SXE_META_MAGIC1;
+    header[2] = SXE_META_MAGIC2;
+    header[3] = SXE_META_MAGIC3;
+    write16le(header + 4, SXE_META_VERSION);
+    write16le(header + 6, SXE_META_HEADER_BYTES);
+    /* records in tag order, as the generator writes them */
+    sx_put_record(s, SXE_TAG_NAME, name, name_length);
+    sx_put_record(s, SXE_TAG_SUBSYSTEM, &subsystem, 1);
+    header = s->data; /* section_ptr_add may have moved it */
+    write32le(header + 8, s->data_offset);
+    write32le(header + 12, 2);
+}
