/build/
# Saved Claude Code sessions: local to each checkout, never part of the tree.
/sessions/
__pycache__/

# Una libreria compartida en la RAIZ del arbol es siempre un bug de un script que
# perdio su cd. Se versiono una vez: libffmpeg.so.0.4, 7 MB, porque link.sh dejo de
# hacer `cd "$OUT"` y el -o resolvio contra el directorio desde el que se leia. No se
# ignores *.so en general --los .so de build/ ya estan fuera por build/--, solo la
# raiz, que es donde ese error cae.
/*.so
/*.so.*
*.pyc
# The Limine checkout build.sh clones, and the maintainer-only art generator
# (the checked-in PNGs are the source of the art). Anything else under tools/
# is part of the repository.
/tools/limine/
/tools/icon_art.py
*.log
# Official ports are versioned; local experiments remain ignored.
ports/*
!ports/README.md
!ports/AGENTS.md
!ports/CLAUDE.md
!ports/doomgeneric/
!ports/doomgeneric/**
!ports/ffmpeg/
!ports/ffmpeg/**
!ports/ccleste/
!ports/ccleste/**
!ports/tinycc/
!ports/tinycc/**
!ports/openssl/
!ports/openssl/**
!ports/xash3d/
!ports/xash3d/**
ports/doomgeneric/wad/*.wad
!ports/doomgeneric/wad/
!ports/doomgeneric/wad/README.md

# The icon art generators are kept on the maintainer's machine only: the
# checked-in PNGs (and the player's icons.inc) are the source of the art.
subsystems/posix/userland/mediaplayer/gen_icons.py
